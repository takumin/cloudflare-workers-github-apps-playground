{
	"name": "cloudflare-workers-github-apps-playground",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"packageManager": "pnpm@11.15.1",
	"engines": {
		"node": "24.18.0",
		"pnpm": "11.15.1",
		"npm": "USE_PNPM"
	},
	"scripts": {
		"preinstall": "pnpm run preinstall:aqua && pnpm run preinstall:hook && pnpm run preinstall:pnpm",
		"preinstall:aqua": "aqua install --all",
		"preinstall:hook": "lefthook install",
		"preinstall:pnpm": "npx -y only-allow pnpm",
		"fmt": "biome check --write",
		"lint": "pnpm run lint:biome && pnpm run lint:oxlint",
		"lint:biome": "biome check",
		"lint:oxlint": "oxlint",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"deploy": "wrangler deploy",
		"destroy": "wrangler delete --force",
		"typegen": "wrangler types && tsc",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json"
	},
	"dependencies": {
		"@octokit/app": "16.1.2",
		"hono": "4.12.31"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.18.7",
		"@types/node": "24.13.3",
		"@vitest/coverage-istanbul": "4.1.10",
		"typescript": "7.0.2",
		"vitest": "4.1.10",
		"wrangler": "4.113.0"
	}
}
